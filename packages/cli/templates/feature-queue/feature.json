{
  "dependencies": ["@forinda/kickjs-queue", "bullmq", "ioredis"],
  "builds": {
    "msgpackr-extract": false
  },
  "integrations": [
    {
      "import": {
        "from": "./adapters/queue",
        "names": ["queueAdapter"]
      },
      "slot": "adapter",
      "code": "// BullMQ over Redis (REDIS_* in src/config).\nqueueAdapter()"
    },
    {
      "slot": "env-zod",
      "code": "REDIS_HOST: z.string().default('127.0.0.1')"
    },
    {
      "slot": "env-zod",
      "code": "REDIS_PORT: z.coerce.number().default(6379)"
    },
    {
      "slot": "env-zod",
      "code": "// No default: a local Redis needs none, a real one needs its own.\nREDIS_PASSWORD: z.string().optional()"
    },
    {
      "slot": "env-valibot",
      "code": "REDIS_HOST: v.optional(v.string(), '127.0.0.1')"
    },
    {
      "slot": "env-valibot",
      "code": "REDIS_PORT: v.optional(v.pipe(v.string(), v.transform(Number)), '6379')"
    },
    {
      "slot": "env-valibot",
      "code": "// No default: a local Redis needs none, a real one needs its own.\nREDIS_PASSWORD: v.optional(v.string())"
    },
    {
      "slot": "env-yup",
      "code": "REDIS_HOST: yup.string().default('127.0.0.1')"
    },
    {
      "slot": "env-yup",
      "code": "REDIS_PORT: yup.number().default(6379)"
    },
    {
      "slot": "env-yup",
      "code": "// No default: a local Redis needs none, a real one needs its own.\nREDIS_PASSWORD: yup.string().optional()"
    }
  ]
}
