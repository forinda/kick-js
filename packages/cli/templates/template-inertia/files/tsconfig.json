{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "outDir": "dist",
    "paths": {
      "@/*": ["./src/*"],
      "~/*": ["./src/client/*"]
    }
  },
  "include": ["src", "db", "*.config.ts", ".kickjs/types/**/*.d.ts", ".kickjs/types/**/*.ts"]
}
