{
  "dependencies": [
    "@forinda/kickjs-inertia",
    "@inertiajs/core",
    "@inertiajs/react",
    "react",
    "react-dom"
  ],
  "devDependencies": ["@vitejs/plugin-react", "@types/react", "@types/react-dom"],
  "scripts": {
    "build": "kick build && vite build --config vite.client.config.ts && vite build --config vite.client.config.ts --ssr src/client/ssr.tsx"
