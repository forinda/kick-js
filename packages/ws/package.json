{
  "name": "@forinda/kickjs-ws",
  "version": "7.1.1",
  "description": "Realtime for KickJS: decorator-driven WebSocket controllers on ws or Socket.IO, a Redis broker for multiple instances, and a Centrifugo integration",
  "keywords": [
    "kickjs",
    "nodejs",
    "typescript",
    "decorator-driven",
    "websocket",
    "ws",
    "socket.io",
    "centrifugo",
    "redis",
    "pubsub",
    "realtime",
    "rooms",
    "namespaces",
    "heartbeat",
    "decorator-websocket"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./redis": {
      "import": "./dist/redis.mjs",
      "types": "./dist/redis.d.mts"
    },
    "./socket.io": {
      "import": "./dist/socket-io.mjs",
      "types": "./dist/socket-io.d.mts"
    },
    "./centrifugo": {
      "import": "./dist/centrifugo.mjs",
      "types": "./dist/centrifugo.d.mts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "bench": "node bench/run.mjs",
    "clean": "rm -rf dist .wireit"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@forinda/kickjs": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "@swc/core": "^1.16.1",
    "@types/node": "^26.4.1",
    "@types/ws": "^8.18.0",
    "ioredis": "^5.10.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "ws": "^8.21.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Felix Orinda",
  "engines": {
    "node": ">=20.0"
  },
  "homepage": "https://kickjs.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/forinda/kick-js.git",
    "directory": "packages/ws"
  },
  "bugs": {
    "url": "https://github.com/forinda/kick-js/issues"
  },
  "peerDependencies": {
    "@forinda/kickjs": ">=5.18.0",
    "socket.io": "^4.0.0",
    "ws": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "socket.io": {
      "optional": true
    }
  }
}
