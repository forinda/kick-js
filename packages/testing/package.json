{
  "name": "@forinda/kickjs-testing",
  "version": "8.2.0",
  "description": "Test utilities, TestModule builder, and helpers for KickJS applications",
  "keywords": [
    "kickjs",
    "nodejs",
    "typescript",
    "decorator-driven",
    "testing",
    "vitest",
    "supertest",
    "integration-testing",
    "test-utilities",
    "test-module-builder",
    "test-app"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./vitest": {
      "import": "./dist/vitest.mjs",
      "types": "./dist/vitest.d.mts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .wireit"
  },
  "peerDependencies": {
    "@forinda/kickjs": ">=5.18.0",
    "express": "^5.1.0",
    "supertest": ">=7.0.0",
    "vitest": ">=3.0.0"
  },
  "devDependencies": {
    "@forinda/kickjs": "workspace:*",
    "@swc/core": "^1.16.13",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Felix Orinda",
  "engines": {
    "node": ">=20.0"
  },
  "homepage": "https://kickjs.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/forinda/kick-js.git",
    "directory": "packages/testing"
  },
  "bugs": {
    "url": "https://github.com/forinda/kick-js/issues"
  },
  "peerDependenciesMeta": {
    "supertest": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  }
}
