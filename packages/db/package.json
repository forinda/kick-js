{
  "name": "@forinda/kickjs-db",
  "version": "8.2.0",
  "description": "KickJS-native ORM — code-first schema, reversible migrations, multi-dialect SQL builder",
  "keywords": [
    "kickjs",
    "nodejs",
    "typescript",
    "orm",
    "code-first-orm",
    "kysely-wrapper",
    "sql-builder",
    "migrations",
    "query-builder",
    "multi-dialect",
    "postgres",
    "mysql",
    "sqlite"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./pg": {
      "import": "./dist/pg.mjs",
      "types": "./dist/pg.d.mts"
    },
    "./sqlite": {
      "import": "./dist/sqlite.mjs",
      "types": "./dist/sqlite.d.mts"
    },
    "./mysql": {
      "import": "./dist/mysql.mjs",
      "types": "./dist/mysql.d.mts"
    },
    "./testing": {
      "import": "./dist/testing.mjs",
      "types": "./dist/testing.d.mts"
    },
    "./schema": {
      "import": "./dist/schema.mjs",
      "types": "./dist/schema.d.mts"
    },
    "./cli": {
      "import": "./dist/cli.mjs",
      "types": "./dist/cli.d.mts"
    },
    "./devtools-events": {
      "import": "./dist/devtools-events.mjs",
      "types": "./dist/devtools-events.d.mts"
    }
  },
  "bin": {
    "kickjs-db": "./bin/kickjs-db.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --typecheck --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .wireit"
  },
  "dependencies": {
    "@forinda/kickjs-cli-kit": "workspace:*",
    "commander": "^15.0.0",
    "jiti": "^2.7.0",
    "kysely": "0.29.6"
  },
  "peerDependencies": {
    "@forinda/kickjs": ">=8.8.0",
    "@forinda/kickjs-devtools-kit": ">=7.0.0",
    "better-sqlite3": ">=12.0.0",
    "mysql2": ">=3.0.0",
    "pg": ">=8.11.0"
  },
  "peerDependenciesMeta": {
    "@forinda/kickjs-devtools-kit": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@forinda/kickjs": "workspace:*",
    "@forinda/kickjs-devtools-kit": "workspace:*",
    "@forinda/kickjs-schema": "workspace:*",
    "@libsql/client": "^0.18.0",
    "@libsql/kysely-libsql": "^0.4.1",
    "@testcontainers/mysql": "^12.2.0",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "better-sqlite3": "^13.0.3",
    "kysely": "^0.29.6",
    "kysely-d1": "^0.4.0",
    "miniflare": "^4.20260730.0",
    "mysql2": "^3.24.5",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Felix Orinda",
  "engines": {
    "node": ">=20.0"
  },
  "homepage": "https://kickjs.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/forinda/kick-js.git",
    "directory": "packages/db"
  },
  "bugs": {
    "url": "https://github.com/forinda/kick-js/issues"
  }
}
