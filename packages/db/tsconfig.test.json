{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [],
    "paths": {
      "@forinda/kickjs": ["../kickjs/src/index.ts"],
      "@forinda/kickjs/*": ["../kickjs/src/*"],
      "@forinda/kickjs-db": ["./src/index.ts"],
      "@forinda/kickjs-db/pg": ["./src/pg.ts"],
      "@forinda/kickjs-db/*": ["./src/*"]
    }
  },
  "include": ["src", "__tests__"],
  // The dialect suites moved here from the retired db-pg / db-sqlite / db-mysql
  // packages, which never ran `vitest --typecheck`. Each of them declares its own
  // `KickDbRelationsRegister.db` augmentation, and that interface has exactly one
  // owner per TS program (`RegisteredRelations` reads the literal `db` key), so
  // merging them into this program makes every declaration but one lose. They run
  // as runtime tests; keep them out of the type program.
  "exclude": ["__tests__/pg", "__tests__/sqlite", "__tests__/mysql"]
}
