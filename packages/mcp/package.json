{
  "name": "@forinda/kickjs-mcp",
  "version": "9.1.2",
  "description": "Model Context Protocol server adapter for KickJS \u2014 expose @Controller endpoints as MCP tools",
  "keywords": [
    "kickjs",
    "nodejs",
    "typescript",
    "decorator-driven",
    "mcp",
    "model-context-protocol",
    "claude-tools",
    "claude-code",
    "anthropic",
    "tool-server",
    "tool-calling",
    "stdio",
    "cursor",
    "zed"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .wireit"
  },
  "dependencies": {
    "@forinda/kickjs-schema": "workspace:^"
  },
  "peerDependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7",
    "@forinda/kickjs": ">=8.5.0 <11.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/server": {
      "optional": false
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@forinda/kickjs": "workspace:*",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@swc/core": "^1.16.18",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "express": "^5.3.0",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Felix Orinda",
  "engines": {
    "node": ">=20.0"
  },
  "homepage": "https://kickjs.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/forinda/kick-js.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/forinda/kick-js/issues"
  }
}
