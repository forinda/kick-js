{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@forinda/kickjs-view": ["./src/index.ts"],
      "@forinda/kickjs-view/*": ["./src/*"],
      "@forinda/kickjs": ["../kickjs/src/index.ts"],
      "@forinda/kickjs/fastify": ["../kickjs/src/http/runtimes/fastify.ts"],
      "@forinda/kickjs/h3": ["../kickjs/src/http/runtimes/h3.ts"],
      "@forinda/kickjs/web": ["../kickjs/src/web.ts"]
    }
  },
  "include": ["src", "__tests__"],
  // Browser tests: checked by tsconfig.dom-test.json, with DOM types.
  "exclude": ["__tests__/validate-runtime.test.ts", "__tests__/toast-guide.test.ts"]
}
