{
  "name": "@forinda/kickjs-inertia",
  "version": "0.0.0",
  "description": "Inertia.js adapter for KickJS \u2014 server-driven pages rendered by React, Vue or Svelte",
  "keywords": [
    "kickjs",
    "inertia",
    "inertiajs",
    "react",
    "vue",
    "svelte",
    "typescript"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .wireit"
  },
  "devDependencies": {
    "@fastify/middie": "^9.3.4",
    "@forinda/kickjs": "workspace:*",
    "@swc/core": "^1.16.13",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "express": "^5.1.0",
    "fastify": "^5.12.5",
    "h3": "2.0.2",
    "h3-v2": "npm:h3@2.0.2",
    "reflect-metadata": "^0.2.2",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@forinda/kickjs": ">=9.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Felix Orinda",
  "engines": {
    "node": ">=20.0"
  },
  "homepage": "https://kickjs.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/forinda/kick-js.git",
    "directory": "packages/inertia"
  },
  "bugs": {
    "url": "https://github.com/forinda/kick-js/issues"
  }
}
